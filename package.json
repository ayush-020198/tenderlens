{
  "name": "tenderlens-india",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "India-first, evidence-backed tender reading with a free-only Gemma integration.",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:server && npm --prefix frontend run build",
    "start": "node server/dist/index.js",
    "dev:api": "tsx server/src/index.ts",
    "test": "tsx --test server/tests/*.test.ts",
    "check": "npm run build:server && npm test && npm --prefix frontend run lint",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "samples": "tsx server/scripts/fetch-samples.ts",
    "evaluate:retrieval": "tsx server/scripts/check-retrieval.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "express": "5.2.1",
    "multer": "2.4.0",
    "pdf-parse": "2.4.5",
    "pdfkit": "0.20.2",
    "sharp": "^0.34.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.2"
  }
}
