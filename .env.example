# Keep this file's real values in .env, never in Git or frontend variables.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Set true only after confirming the Google project is Free tier with billing disabled.
GEMINI_FREE_TIER_CONFIRMED=false
TENDERLENS_DATA_DIR=./data
# bm25 works immediately. hybrid requires a local Ollama embedding model.
RETRIEVAL_MODE=bm25
EMBEDDING_MODEL=embeddinggemma
OCR_ENABLED=true
OCR_LANGUAGES=eng
# Both eng and hin model assets are installed from npm; OCR does not download at runtime.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# This single-user prototype only binds to loopback. Do not expose it publicly.
PORT=8000
