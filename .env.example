# Keep this file's real values in .env, never in Git or frontend variables.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
TENDERLENS_DATA_DIR=./data
# bm25 works immediately. hybrid needs: uv sync --extra retrieval
RETRIEVAL_MODE=bm25
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANK_ENABLED=false
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
OCR_ENABLED=false
OCR_LANGUAGES=eng
# Use eng+hin after installing both Tesseract language packs.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Do not expose this single-user prototype to the internet.
ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
